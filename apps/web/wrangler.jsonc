{
	// The workspace uses a flat node_modules at the repository root, so the schema
	// is two levels up and not in this directory. See pnpm-workspace.yaml.
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "dotcom-web",
	"compatibility_date": "2026-08-10",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	// ONE ADDRESS, www.kashinoga.com below. A workers.dev copy would be the same
	// site, trip and all, somewhere nobody meant it to be.
	"workers_dev": false,
	// NO PREVIEW URLS. A preview runs with this Worker's secrets and its database,
	// at a public address, so a version uploaded to try something would be trying
	// it on the real trip with the real passcode.
	"preview_urls": false,

	// THE SITE'S ADDRESS, which is www. The bare kashinoga.com is not served
	// here: it has an originless proxied record, and the account's Bulk Redirect
	// list "www" sends it on to www with its path and query.
	"routes": [{ "pattern": "www.kashinoga.com", "custom_domain": true }],

	// THE TRIP'S DATABASE. No `database_id`: `wrangler deploy` creates the
	// database the first time and remembers it, and `vite dev` keeps a local one
	// under .wrangler/. See src/lib/server/trip.ts for why D1 and not KV.
	"d1_databases": [
		{
			"binding": "TRIP_DB",
			"database_name": "dotcom-trip",
		},
	],

	// Five passcode guesses a minute per address. `namespace_id` is any number
	// of this account's choosing; it names the counter, and nothing else uses it.
	"ratelimits": [
		{
			"name": "TRIP_UNLOCK",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 },
		},
	],

	// THE TRIP'S ADDRESS AND PASSCODE are secrets and are not written here, because
	// this repository is public. The page answers only at /shared/<TRIP_SLUG>.
	// Set both with `pnpm --filter web exec wrangler secret put TRIP_SLUG` (and
	// TRIP_PASSCODE), and for local work put `TRIP_SLUG=…` and `TRIP_PASSCODE=…`
	// in apps/web/.dev.vars, which git ignores.
}
