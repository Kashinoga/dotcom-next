{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "node -e \"require('node:fs').rmSync('.svelte-kit/cloudflare', { recursive: true, force: true, maxRetries: 10, retryDelay: 300 })\" && vite build && wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "wrangler types && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"trip:seed": "node scripts/trip-seed.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/merriweather": "^5.3.0",
		"@lucide/svelte": "^1.48.0",
		"dompurify": "^3.4.16",
		"github-slugger": "^2.0.0",
		"highlight.js": "^11.12.0",
		"leaflet": "^1.9.4",
		"markdown-it": "^15.0.2",
		"monaco-editor": "^0.57.0"
	}
}
